# Service systemd pour ISROBOT.
#
# Installation :
#   sudo useradd --system --home /opt/isrobot isrobot
#   sudo mkdir -p /opt/isrobot && sudo cp isrobot /opt/isrobot/ && sudo chown -R isrobot /opt/isrobot
#   sudo cp deploy/isrobot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now isrobot
#   journalctl -u isrobot -f
[Unit]
Description=ISROBOT (bot Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isrobot
WorkingDirectory=/opt/isrobot
ExecStart=/opt/isrobot/isrobot
Restart=on-failure
RestartSec=5
# Arrêt gracieux (SIGTERM) puis arrêt forcé après 20 s
TimeoutStopSec=20

# Durcissement
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/isrobot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
